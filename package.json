{"name": "codebuddy-enhance", "displayName": "CodeBuddy Enhance", "description": "Real-time timing, token counting, and daily statistics for CodeBuddy", "version": "0.1.0", "engines": {"vscode": "^1.85.0"}, "categories": ["Other"], "activationEvents": ["onStartupFinished"], "main": "./out/index.js", "contributes": {"commands": [{"command": "codebuddy.enhance.sum", "title": "CodeBuddy: Show Daily Summary (/sum)", "category": "CodeBuddy Enhance"}, {"command": "codebuddy.enhance.showOutput", "title": "CodeBuddy Enhance: Show Output Log", "category": "CodeBuddy Enhance"}]}, "scripts": {"vscode:prepublish": "npm run compile", "compile": "tsc -p ./", "watch": "tsc -watch -p ./", "lint": "eslint src --ext ts"}, "devDependencies": {"@types/node": "^20.x", "@types/vscode": "^1.85.0", "typescript": "^5.x"}, "dependencies": {"tiktoken": "^1.0.16"}}