{"name": "codebuddy-enhance", "displayName": "CodeBuddy Enhance", "description": "Real-time timing, token counting, and daily statistics for CodeBuddy", "version": "0.1.0", "engines": {"vscode": "^1.85.0"}, "categories": ["Other"], "activationEvents": ["onStartupFinished", "onCommand:codebuddy.enhance.testTimer"], "main": "./out/index.js", "contributes": {"commands": [{"command": "codebuddy.enhance.sum", "title": "CodeBuddy: Show Daily Summary (/sum)", "category": "CodeBuddy Enhance"}, {"command": "codebuddy.enhance.showOutput", "title": "CodeBuddy Enhance: Show Output Log", "category": "CodeBuddy Enhance"}, {"command": "codebuddy.enhance.showStatsPanel", "title": "CodeBuddy Enhance: Show Stats Panel (计时+统计)", "category": "CodeBuddy Enhance"}, {"command": "codebuddy.enhance.closeStatsPanel", "title": "CodeBuddy Enhance: Close Stats Panel", "category": "CodeBuddy Enhance"}, {"command": "codebuddy.enhance.testTimer", "title": "CodeBuddy Enhance: Test Timer", "category": "CodeBuddy Enhance"}], "keybindings": [{"command": "codebuddy.enhance.sum", "key": "ctrl+shift+s", "mac": "cmd+shift+s"}], "menus": {}}, "scripts": {"vscode:prepublish": "npm run compile", "compile": "tsc -p ./", "watch": "tsc -watch -p ./", "lint": "eslint src --ext ts"}, "devDependencies": {"@types/node": "^20.x", "@types/vscode": "^1.85.0", "typescript": "^5.x"}, "dependencies": {"tiktoken": "^1.0.16"}}